<Window x:Class="A0Utils.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A0Utils.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="820" Width="680"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <local:GroupExpandConverter x:Key="GroupExpandConverter"/>

        <!-- Группировка списков: категория -> группа (регион, год, предыдущие версии) -> подгруппа (год) -->
        <CollectionViewSource x:Key="GroupedUpdateModels" Source="{Binding UpdateModels}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
                <PropertyGroupDescription PropertyName="Group1"/>
                <PropertyGroupDescription PropertyName="Group2"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="GroupedUpdateModelsWithoutLicense" Source="{Binding UpdateModelsWithoutLicense}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
                <PropertyGroupDescription PropertyName="Group1"/>
                <PropertyGroupDescription PropertyName="Group2"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Кнопки -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Таблицы обновлений -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ColumnLineBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="MinRowHeight" Value="26"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Длинный текст переносится на новую строку, чтобы ничего не обрезалось -->
        <Style x:Key="WrapTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Название — главный столбец: тёмный полужирный текст. Описание и дата — серые и мельче -->
        <Style x:Key="NameTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WrapTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="DescriptionTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WrapTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="DateTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Таблица скрыта, пока лицензия не загружена (вместо неё подсказка) -->
        <Style x:Key="UpdatesGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateModels}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtraGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateModelsWithoutLicense}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UpdatesPlaceholderStyle" TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateModels}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtraPlaceholderStyle" TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateModelsWithoutLicense}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Красный текст для закончившейся лицензии или подписки -->
        <Style x:Key="A0ExpStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsA0Expired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PIRExpStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPIRExpired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SubscriptionExpStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSubscriptionExpired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Сворачиваемый заголовок группы: стрелка + название + количество -->
        <Style x:Key="GroupExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Padding="{TemplateBinding Padding}" Cursor="Hand" Focusable="False"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Bd" Background="{StaticResource GroupBrush}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow" Data="M0,0 L5,4.5 L0,9 Z" Fill="{StaticResource MutedTextBrush}"
                                                      Width="6" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupHeaderTemplate">
            <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource MutedTextBrush}"/>
            </TextBlock>
        </DataTemplate>

        <!-- Шаблон группы без заголовка: для элементов, которые не нужно группировать -->
        <ControlTemplate x:Key="PlainGroupTemplate" TargetType="{x:Type GroupItem}">
            <ItemsPresenter/>
        </ControlTemplate>

        <!-- Уровень 1: категория (A0, ПИР, Базы НСИ, Справочники цен...) -->
        <Style x:Key="CategoryGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <Border Background="{StaticResource CategoryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,6">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentDarkBrush}"/>
                            </Border>
                            <ItemsPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Уровень 2: регион / год индексов / предыдущие версии базы.
             Раскрыты самый свежий год индексов и регион, если он в списке один; остальное свёрнуто -->
        <Style x:Key="SubGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander Style="{StaticResource GroupExpanderStyle}" Padding="10,5"
                                  IsExpanded="{Binding Mode=OneTime, Converter={StaticResource GroupExpandConverter}, ConverterParameter=1}"
                                  Header="{Binding}" HeaderTemplate="{StaticResource GroupHeaderTemplate}">
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="">
                    <Setter Property="Template" Value="{StaticResource PlainGroupTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value=" ">
                    <Setter Property="Template" Value="{StaticResource PlainGroupTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Уровень 3: годы внутри региона. Самый свежий год раскрыт, остальные свёрнуты -->
        <Style x:Key="NestedSubGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander Style="{StaticResource GroupExpanderStyle}" Padding="28,4"
                                  IsExpanded="{Binding Mode=OneTime, Converter={StaticResource GroupExpandConverter}, ConverterParameter=2}"
                                  Header="{Binding}" HeaderTemplate="{StaticResource GroupHeaderTemplate}">
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="">
                    <Setter Property="Template" Value="{StaticResource PlainGroupTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value=" ">
                    <Setter Property="Template" Value="{StaticResource PlainGroupTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <!-- Высота меняется в MainWindow.xaml.cs при сворачивании раздела -->
            <RowDefinition x:Name="ExtraResourcesRow" Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Настройки" Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Загрузка обновлений для программы А0" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Лицензия -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Лицензия" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Licenses}" SelectedItem="{Binding SelectedLicense}"
                          Padding="6,4" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Обновить список" Command="{Binding RefreshLicensesCommand}" Margin="0,0,6,0"/>
                    <Button Content="Управление лицензиями" Command="{Binding OpenLicenseCommand}"/>
                </StackPanel>

                <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="True">
                    <Button Content="Получить обновления" Command="{Binding GetLicenseInfoCommand}" Style="{StaticResource PrimaryButton}"
                            DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                    <StackPanel>
                        <TextBlock Text="{Binding A0LicenseExp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource A0ExpStyle}"/>
                        <TextBlock Text="{Binding PIRLicenseExp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PIRExpStyle}"/>
                        <TextBlock Text="{Binding SubscriptionLicenseExp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SubscriptionExpStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Доступные обновления -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Доступные обновления" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Grid.Row="0" Text="отметьте нужные и нажмите «Скачать»" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,0,7" Foreground="{StaticResource MutedTextBrush}"/>

            <Border Grid.Row="1" Style="{StaticResource UpdatesPlaceholderStyle}" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="Выберите лицензию и нажмите «Получить обновления»" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
            </Border>
            <DataGrid Grid.Row="1" Style="{StaticResource UpdatesGridStyle}" ItemsSource="{Binding Source={StaticResource GroupedUpdateModels}}">
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource CategoryGroupStyle}"/>
                    <GroupStyle ContainerStyle="{StaticResource SubGroupStyle}"/>
                    <GroupStyle ContainerStyle="{StaticResource NestedSubGroupStyle}"/>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="34" CanUserResize="False">
                        <DataGridTemplateColumn.Header>
                            <!-- Отметить все / снять все -->
                            <CheckBox IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                      ToolTip="Отметить все / снять все" Cursor="Hand" HorizontalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="3*" MinWidth="120" ElementStyle="{StaticResource NameTextStyle}"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Index}" Width="4*" MinWidth="120" ElementStyle="{StaticResource DescriptionTextStyle}"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="92" CanUserResize="False" ElementStyle="{StaticResource DateTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Загрузка -->
            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="8" Margin="0,8,0,0"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}" BorderThickness="0"/>

            <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,8,0,0">
                <Button Content="Скачать" Command="{Binding DownloadSelectedCommand}" Style="{StaticResource PrimaryButton}"
                        DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="100"/>
                <Button Content="Обзор" Command="{Binding SaveToCommand}" DockPanel.Dock="Right"/>
                <TextBlock Text="Папка:" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DownloadPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                           Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadPath}"/>
            </DockPanel>
        </Grid>

        <!-- Граница между списками: тянется мышью, когда раздел заявки раскрыт -->
        <GridSplitter x:Name="SectionSplitter" Grid.Row="3" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"
                      Visibility="Collapsed" ToolTip="Потяните, чтобы изменить размер">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="{TemplateBinding Background}">
                        <Border Width="40" Height="4" CornerRadius="2" Background="{StaticResource BorderBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Заявка на лицензию: выделена цветом. По умолчанию свёрнута, чтобы окно помещалось на небольших экранах -->
        <Border Grid.Row="4" Margin="0,10,0,10" Background="{StaticResource RequestBrush}" BorderBrush="{StaticResource RequestBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="6,2,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToggleButton x:Name="ExtraResourcesToggle" Grid.Row="0" IsChecked="False" Cursor="Hand" Focusable="False"
                              Checked="ExtraResourcesToggle_Changed" Unchecked="ExtraResourcesToggle_Changed"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="Показать / скрыть">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Bd" Background="Transparent" Padding="4,7,8,7" CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Arrow" Data="M0,0 L5,4.5 L0,9 Z" Fill="{StaticResource RequestTextBrush}"
                                          Width="6" Height="9" Margin="2,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RequestTextBrush}" VerticalAlignment="Center">
                                        <Run Text="Оформить заявку на лицензию"/>
                                        <Run Text="— дополнительные ресурсы и продление" FontWeight="Normal" FontSize="12"
                                             Foreground="{StaticResource MutedTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RequestHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Grid x:Name="ExtraResourcesPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource ExtraPlaceholderStyle}" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="Выберите лицензию и нажмите «Получить обновления»" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                </Border>
                <DataGrid Grid.Row="0" Style="{StaticResource ExtraGridStyle}" ItemsSource="{Binding Source={StaticResource GroupedUpdateModelsWithoutLicense}}">
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource CategoryGroupStyle}"/>
                        <GroupStyle ContainerStyle="{StaticResource SubGroupStyle}"/>
                        <GroupStyle ContainerStyle="{StaticResource NestedSubGroupStyle}"/>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="3*" MinWidth="120" ElementStyle="{StaticResource NameTextStyle}"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Index}" Width="4*" MinWidth="120" ElementStyle="{StaticResource DescriptionTextStyle}"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="92" CanUserResize="False" ElementStyle="{StaticResource DateTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
                    <Button Content="Запросить счёт" Command="{Binding RequestInvoiceCommand}" Style="{StaticResource PrimaryButton}"
                            DockPanel.Dock="Right" MinWidth="120" ToolTip="Сформировать письмо с просьбой выставить счёт на отмеченные ресурсы и продление"/>
                    <TextBlock Text="Отметьте ресурсы, которые хотите добавить в лицензию. Продление А0, ПИР и подписки выбирается в следующем окне" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <StatusBar Grid.Row="5" Margin="-14,0,-14,0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0" Foreground="{StaticResource MutedTextBrush}" Padding="8,2">
            <StatusBarItem>
                <TextBlock Text="{Binding AssemblyCopyright}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding AssemblyCompany}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="&#x260E;" FontFamily="Segoe UI Symbol" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text="8 (8142) 76-04-34, доб. 3" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink NavigateUri="mailto:nik@rccs.sampo.ru" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource AccentBrush}" ToolTip="Написать письмо">
                        <Run Text="nik@rccs.sampo.ru"/>
                    </Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AssemblyVersion}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Command="{Binding CheckForAppUpdateCommand}" Padding="3" ToolTip="Проверить обновление утилиты">
                        <Image Source="update.png" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
