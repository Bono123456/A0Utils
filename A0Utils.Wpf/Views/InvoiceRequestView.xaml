<Window x:Class="A0Utils.Wpf.Views.InvoiceRequestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запрос счёта" Width="680" Height="760" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run Text="Письмо для "/><Run Text="{Binding Email, Mode=OneWay}" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="Выберите продление и заполните реквизиты. Предпросмотр обновляется автоматически; введённые данные сохраняются при изменении галочек."/>
                </TextBlock>
                <StackPanel Visibility="{Binding HasRenewals, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                    <TextBlock Text="Продление (если требуется)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Renewals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="_Организация" Target="{Binding ElementName=OrganizationBox}"/>
                    <TextBox x:Name="OrganizationBox" Grid.Row="0" Grid.Column="1" Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="1" Content="_ИНН" Target="{Binding ElementName=InnBox}"/>
                    <TextBox x:Name="InnBox" Grid.Row="1" Grid.Column="1" Text="{Binding Inn, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="2" Content="_Контактное лицо" Target="{Binding ElementName=ContactBox}"/>
                    <TextBox x:Name="ContactBox" Grid.Row="2" Grid.Column="1" Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="3" Content="_Телефон" Target="{Binding ElementName=PhoneBox}"/>
                    <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="4" Content="Ко_мментарий" Target="{Binding ElementName=CommentsBox}"/>
                    <TextBox x:Name="CommentsBox" Grid.Row="4" Grid.Column="1" Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"/>
                </Grid>
                <TextBlock Text="Предпросмотр письма" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBox x:Name="SubjectPreview" Text="{Binding Subject, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                <TextBox x:Name="BodyPreview" Text="{Binding Body, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Height="210" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Дальнейшие правки можно внести в почтовой программе. Если она не открывается, скопируйте текст письма."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="Выберите хотя бы одно продление или отметьте дополнительные ресурсы в главном окне."
                           TextWrapping="Wrap" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSend}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding CopyButtonText}" Command="{Binding CopyTextCommand}"/>
            <Button Content="Открыть в почте" Command="{Binding OpenMailCommand}"/>
            <Button Content="Закрыть" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
